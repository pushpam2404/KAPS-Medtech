# Copy to backend/.env for local work. Never commit the real file.

# PostgreSQL connection string (local, Neon, Supabase, ...)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaps_health

# Long random string used to sign login tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Optional ---
PORT=3001

# Doctors can register themselves only if this is set, and must enter it.
# The seeded and demo doctors work without it.
DOCTOR_SIGNUP_CODE=

# Comma-separated origins allowed to call the API from another site.
# Leave empty when this server also serves the frontend.
ALLOWED_ORIGINS=

# TLS to the database. Used automatically for Neon, Supabase and NODE_ENV=production.
#   verify  (default) check the server certificate
#   relaxed encrypt but do not check the certificate
#   off     no TLS
DATABASE_SSL=
# PEM text of an extra CA to trust, for databases with a private CA (Supabase pooler).
DATABASE_CA=

# The sign-in page offers one-click demo accounts. Set to "off" for a real deployment.
DEMO_MODE=

# npm run db:seed:demo and db:reset:demo refuse to run when NODE_ENV=production
# unless this is 1.
ALLOW_DEMO_SEED=
