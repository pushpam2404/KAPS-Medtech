# Copy to backend/.env for local work. Never commit the real file.

# PostgreSQL connection string (local, Neon, Supabase, ...)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaps_health

# Long random string used to sign login tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional
PORT=3001
# Comma-separated origins allowed to call the API from another site.
# Leave empty when the frontend is served by this same server.
ALLOWED_ORIGINS=
# Doctors cannot self-register unless this is set. Share it only with
# people who should be able to create a doctor account.
DOCTOR_SIGNUP_CODE=
# Set to true to force SSL for a database that is not Neon/Supabase.
DB_SSL=
