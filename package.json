  "author": "pushpam2404",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushpam2404/KAPS-Medtech.git"
  },
  "main": "backend/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node backend/server.js",
    "db:init": "node backend/init_db.js",
    "test": "node --test \"test/unit/*.test.js\"",
